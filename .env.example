# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012
AWS_PROFILE=default

# S3 Naming Prefix (must be globally unique)
# This prefix is used for all S3 buckets created by Terraform
S3_NAMING_PREFIX=mycompany-crypto

# API Keys
# Get CoinGecko API key from: https://www.coingecko.com/en/api
COINGECKO_API_KEY=your_coingecko_api_key_here

# Get CryptoNews token from: https://cryptonews-api.com/
CRYPTONEWS_TOKEN=your_cryptonews_token_here

# CryptoNews API Configuration
CRYPTONEWS_URL=https://cryptonews-api.com/api/v1/category?section=general&items=50&page=1

# LLM Backend Configuration
# Options: "litellm" (AWS Bedrock via proxy) or "ollama" (local)
LLM_BACKEND=litellm
LLM_MODE=bedrock

# LiteLLM Configuration (if using litellm backend)
LITELLM_MODEL_NAME=bedrock-claude-haiku
LITELLM_BASE_URL=http://litellm:4000
LITELLM_API_KEY=sk-noop

# Ollama Configuration (if using ollama backend)
OLLAMA_MODEL=llama2
OLLAMA_BASE_URL=http://localhost:11434

# Bedrock Configuration
BEDROCK_PROVIDER=anthropic

# MCP (Model Context Protocol) Configuration
# Options: "stdio" (local process) or "streamable_http" (HTTP server)
MCP_MODE=stdio
MCP_DBT_CMD=python
MCP_DBT_SCRIPT=/app/tools/query_tools/mcp_tools.py
MCP_DBT_CWD=/app

# For HTTP mode:
# MCP_MODE=streamable_http
# MCP_DBT_URL=http://dbt-mcp:8001
# MCP_DBT_PATH=/mcp

# News Agent Configuration
MAX_ARTICLES=50
TIMEOUT_S=15
EXTRACTOR_TEMPERATURE=0.3
EXTRACT_CONCURRENCY=8

# Knowledge Base Ingestion Mode
# Options: "s3" (traditional S3 sync) or "direct" (direct API)
KB_INGEST_MODE=direct
WAIT_FOR_INGEST=true

# Athena Configuration
ATHENA_WORKGROUP=primary
ATHENA_USE_MANAGED_RESULTS=true

# Market Agent Configuration
PAIR_MIN_SIM=0.22

# Observability - Langfuse
# Sign up at: https://cloud.langfuse.com
ENABLE_LANGFUSE=false
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# Logging
LOG_LEVEL=INFO
DEBUG=false

# Email for alerts (optional)
ALERT_EMAIL=your-email@example.com

# Feature Flags
ENABLE_CACHING=true
ENABLE_METRICS=true

# Development Settings
ENVIRONMENT=dev

# ============================================================================
# Infrastructure Outputs (generated by 'make terraform-env')
# These are automatically populated after running Terraform
# DO NOT EDIT MANUALLY - Run 'make terraform-env' to update
# ============================================================================

# These will be populated by terraform-env:
# NEWS_KB_ID=
# NEWS_KB_DS_ID=
# NEWS_KB_BUCKET=
# NEWS_KB_PREFIX=
# RESEARCH_KB_ID=
# RESEARCH_KB_DS_ID=
# RESEARCH_KB_BUCKET=
# RESEARCH_KB_PREFIX=
# AURORA_CLUSTER_ARN=
# AURORA_SECRET_ARN=
# AURORA_DB_NAME=
# RESEARCH_TABLE=
# NEWS_TABLE=
